{
  "name": "blog-manage-web",
  "version": "2.2.9",
  "scripts": {
    "dev": "vite --mode dev",
    "dev:debug": "vite --mode dev --debug",
    "dev:prod": "vite --mode prod-local",
    "build": "vue-tsc --noEmit && vite build --mode prod",
    "preview": "vite preview --outDir manage --base /manage/",
    "lint": "eslint \"{src,mock,build,types}/**/*.{vue,ts,tsx}\" --fix && vue-tsc --noEmit",
    "lint:stylelint": "stylelint --fix \"**/*.{vue,less,postcss,css,scss}\" --cache --cache-location node_modules/.cache/stylelint/",
    "reinstall": "rimraf yarn.lock && rimraf package.lock.json && rimraf node_modules && yarn"
  },
  "dependencies": {
    "@antv/g2plot": "^2.4.31",
    "@vicons/antd": "^0.12.0",
    "@vicons/ionicons5": "^0.12.0",
    "@vueuse/core": "^10.3.0",
    "await-to-js": "^3.0.0",
    "axios": "^1.4.0",
    "date-fns": "^2.30.0",
    "echarts": "^5.4.3",
    "element-resize-detector": "^1.2.4",
    "makeit-captcha": "^2.0.6",
    "md-editor-v3": "^4.8.1",
    "mockjs": "^1.1.0",
    "naive-ui": "^2.35.0",
    "pinia": "^2.1.6",
    "qs": "^6.11.2",
    "vue": "^3.3.4",
    "vue-router": "^4.2.4",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@types/element-resize-detector": "^1.1.3",
    "@types/node": "^20.4.5",
    "@types/qs": "^6.9.7",
    "@typescript-eslint/eslint-plugin": "^6.4.1",
    "@typescript-eslint/parser": "^6.4.1",
    "@vitejs/plugin-vue": "^4.2.3",
    "@vitejs/plugin-vue-jsx": "^3.0.1",
    "autoprefixer": "^10.4.14",
    "eslint": "^8.46.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "eslint-plugin-vue": "^9.16.1",
    "postcss": "^8.4.27",
    "postcss-html": "^1.5.0",
    "postcss-scss": "^4.0.6",
    "prettier": "^3.0.0",
    "sass": "^1.64.2",
    "sass-loader": "^13.3.2",
    "stylelint": "^15.10.2",
    "stylelint-config-rational-order": "^0.1.2",
    "stylelint-config-standard": "^34.0.0",
    "stylelint-config-standard-scss": "^10.0.0",
    "stylelint-config-standard-vue": "^1.0.0",
    "stylelint-no-unsupported-browser-features": "^7.0.0",
    "stylelint-order": "^6.0.3",
    "terser": "^5.19.2",
    "typescript": "5.1.6",
    "vite": "^4.4.7",
    "vite-plugin-html": "^3.2.0",
    "vite-plugin-mock": "^3.0.0",
    "vue-eslint-parser": "^9.3.1",
    "vue-tsc": "^1.8.8"
  },
  "lint-staged": {
    "*.{vue,js,ts,tsx}": "eslint --fix"
  },
  "license": "MIT",
  "keywords": [
    "vue",
    "naive-ui",
    "blog-manage-web",
    "vue3",
    "ts",
    "tsx",
    "admin",
    "typescript"
  ],
  "engines": {
    "node": "^12 || >=14"
  }
}
