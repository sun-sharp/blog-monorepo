{
  "name": "blog-manage-web",
  "version": "2.0.2",
  "scripts": {
    "dev": "vite --mode dev",
    "dev:prod": "vite --mode prod-local",
    "dev:debug": "vite --mode dev --debug",
    "build": "vue-tsc --noEmit && vite build --mode prod",
    "preview": "vite preview",
    "lint": "eslint \"{src,mock,build,types}/**/*.{vue,ts,tsx}\" --fix && vue-tsc --noEmit",
    "lint:stylelint": "stylelint --fix \"**/*.{vue,less,postcss,css,scss}\" --cache --cache-location node_modules/.cache/stylelint/",
    "reinstall": "rimraf yarn.lock && rimraf package.lock.json && rimraf node_modules && yarn"
  },
  "dependencies": {
    "@antv/g2plot": "^2.4.26",
    "@vicons/antd": "^0.12.0",
    "@vicons/ionicons5": "^0.12.0",
    "await-to-js": "^3.0.0",
    "axios": "^1.2.2",
    "date-fns": "^2.29.3",
    "echarts": "^5.4.1",
    "element-resize-detector": "^1.2.4",
    "makeit-captcha": "^2.0.3",
    "md-editor-v3": "^2.7.2",
    "mockjs": "^1.1.0",
    "naive-ui": "^2.34.3",
    "pinia": "^2.0.28",
    "qs": "^6.11.0",
    "vue": "^3.2.45",
    "vue-router": "^4.1.6",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^18.11.18",
    "@types/qs": "^6.9.7",
    "@typescript-eslint/eslint-plugin": "^5.47.1",
    "@typescript-eslint/parser": "^5.47.1",
    "@vitejs/plugin-vue": "^4.0.0",
    "@vitejs/plugin-vue-jsx": "^3.0.0",
    "@vueuse/core": "^9.9.0",
    "autoprefixer": "^10.4.13",
    "eslint": "^8.30.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-vue": "^9.8.0",
    "postcss": "^8.4.20",
    "postcss-html": "^1.5.0",
    "prettier": "^2.8.1",
    "sass": "^1.63.4",
    "sass-loader": "^13.3.2",
    "stylelint": "^14.16.1",
    "stylelint-config-prettier": "^9.0.4",
    "stylelint-config-standard": "^29.0.0",
    "stylelint-order": "^5.0.0",
    "stylelint-scss": "^4.3.0",
    "terser": "^5.16.1",
    "typescript": "^4.9.4",
    "vite": "^4.0.3",
    "vite-plugin-html": "^3.2.0",
    "vite-plugin-mock": "^2.9.6",
    "vue-eslint-parser": "^9.1.0",
    "vue-tsc": "^1.0.18"
  },
  "lint-staged": {
    "*.{vue,js,ts,tsx}": "eslint --fix"
  },
  "license": "MIT",
  "keywords": [
    "vue",
    "naive-ui",
    "blog-manage-web",
    "vue3",
    "ts",
    "tsx",
    "admin",
    "typescript"
  ],
  "engines": {
    "node": "^12 || >=14"
  }
}
