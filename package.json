{
  "name": "vue3-ts-manage",
  "version": "1.0.0",
  "scripts": {
    "dev": "vite --mode dev",
    "dev:prod": "vite --mode prod-local",
    "dev:debug": "vite --mode dev --debug",
    "build": "vue-tsc --noEmit && vite build --mode prod",
    "preview": "vite preview",
    "lint": "eslint \"{src,mock,build,types}/**/*.{vue,ts,tsx}\" --fix && vue-tsc --noEmit",
    "lint:stylelint": "stylelint --fix \"**/*.{vue,less,postcss,css,scss}\" --cache --cache-location node_modules/.cache/stylelint/",
    "reinstall": "rimraf yarn.lock && rimraf package.lock.json && rimraf node_modules && yarn"
  },
  "dependencies": {
    "@vicons/antd": "^0.11.0",
    "@vicons/ionicons5": "^0.11.0",
    "await-to-js": "^3.0.0",
    "axios": "^0.23.0",
    "date-fns": "^2.25.0",
    "echarts": "^5.2.1",
    "element-resize-detector": "^1.2.3",
    "makeit-captcha": "^1.2.5",
    "md-editor-v3": "^2.4.1",
    "mockjs": "^1.1.0",
    "naive-ui": "^2.19.11",
    "pinia": "^2.0.0-rc.10",
    "qs": "^6.10.3",
    "vue": "^3.2.16",
    "vue-router": "^4.0.12",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^16.11.4",
    "@types/qs": "^6.9.7",
    "@typescript-eslint/eslint-plugin": "^5.1.0",
    "@typescript-eslint/parser": "^5.1.0",
    "@vitejs/plugin-vue": "^1.9.3",
    "@vitejs/plugin-vue-jsx": "^1.2.0",
    "@vueuse/core": "^6.7.4",
    "autoprefixer": "^10.3.7",
    "eslint": "^8.1.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-prettier": "^4.0.0",
    "eslint-plugin-vue": "^7.20.0",
    "esno": "^0.10.1",
    "postcss": "^8.3.11",
    "prettier": "^2.4.1",
    "sass": "^1.49.0",
    "sass-loader": "^12.4.0",
    "stylelint": "^13.13.1",
    "stylelint-config-prettier": "^8.0.2",
    "stylelint-config-standard": "^22.0.0",
    "stylelint-order": "^4.1.0",
    "stylelint-scss": "^3.19.0",
    "terser": "^5.16.0",
    "typescript": "^4.4.4",
    "vite": "2.8.6",
    "vite-plugin-compression": "^0.3.5",
    "vite-plugin-html": "^2.1.1",
    "vite-plugin-mock": "^2.9.6",
    "vue-eslint-parser": "^8.0.0",
    "vue-tsc": "^0.3.0"
  },
  "lint-staged": {
    "*.{vue,js,ts,tsx}": "eslint --fix"
  },
  "license": "MIT",
  "keywords": [
    "vue",
    "naive-ui",
    "vue3-ts-manage",
    "vue3",
    "ts",
    "tsx",
    "admin",
    "typescript"
  ],
  "engines": {
    "node": "^12 || >=14"
  }
}
