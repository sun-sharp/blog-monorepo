{
  "name": "blog-monorepo",
  "private": true,
  "version": "4.5.7",
  "workspaces": [
    "packages/website",
    "packages/admin-web",
    "packages/node-server",
    "packages/shared"
  ],
  "scripts": {
    "start:watch:server": "npm run start:watch_debug --workspace=packages/node-server",
    "typecheck:shared": "npm run typecheck --workspace=packages/shared",
    "git:dev-main-dev": "git push origin dev && git checkout main && git pull origin dev && git push origin main && git checkout dev"
  },
  "dependencies": {
    "@dcloudio/types": "^3.4.32",
    "json5": "^2.2.3"
  }
}
