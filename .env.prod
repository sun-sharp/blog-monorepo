# 网站根目录
VITE_PUBLIC_PATH = /manage/

# token 前加符号
VITE_AUTHORIZATION_HEAD = 'Bearer '

# capital接口地址
VITE_CAPITAL_API_URL = /capital-api

# blog接口地址
VITE_BLOG_API_URL = /blog-api

# 接口前缀
VITE_API_URL_PREFIX = 

# 文件上传地址
VITE_FILE_API_URL = /file-api

# money接口地址
VITE_FILE_API_URL= /money-api

# 图片前缀地址
VITE_IMG_URL= https://api.yangruirui.top

# 是否启用gzip压缩或brotli压缩
# 可选: gzip | brotli | none
# 如果你需要多种形式，你可以用','来分隔
VITE_BUILD_COMPRESS = 'none'

# 使用压缩时是否删除原始文件，默认为false
VITE_BUILD_COMPRESS_DELETE_ORIGIN_FILE = false
