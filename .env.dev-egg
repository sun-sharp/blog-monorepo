# 只在开发模式中被载入
VITE_PORT = 8222

# 网站根目录
VITE_PUBLIC_PATH = /

# 是否删除console
VITE_DROP_CONSOLE = true

# 跨域代理，可以配置多个，请注意不要换行
VITE_PROXY=[["/capital-api","http://127.0.0.1:3000/capital"], ["/blog-api","http://127.0.0.1:3000/blog"], ["/files-api","http://127.0.0.1:3000/files"]]

# capital接口地址
VITE_GLOB_CAPITAL_API_URL= /capital-api

# blog接口地址
VITE_GLOB_BLOG_API_URL= /blog-api

# mock接口地址
VITE_GLOB_MOCK_API_URL= /mock-api

# 接口前缀
VITE_GLOB_API_URL_PREFIX = 

# 图片上传地址
VITE_GLOB_UPLOAD_URL= /files-api

# 图片前缀地址
VITE_GLOB_IMG_URL= http://127.0.0.1:3000

