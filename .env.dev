# 只在开发模式中被载入
VITE_PORT = 9222

# 网站根目录
VITE_PUBLIC_PATH = /

# 是否删除console
VITE_DROP_CONSOLE = true

# 跨域代理，可以配置多个，请注意不要换行
VITE_PROXY=[["/capital-api","http://127.0.0.1:3000/capital"], ["/blog-api","http://127.0.0.1:3000/blog"], ["/file-api","http://127.0.0.1:3000/file"], ["/money-api","http://127.0.0.1:3000/money"]]

# capital接口地址
VITE_CAPITAL_API_URL= /capital-api

# blog接口地址
VITE_BLOG_API_URL= /blog-api

# 文件上传地址
VITE_FILE_API_URL= /file-api

# money接口地址
VITE_MONEY_API_URL= /money-api

# 接口前缀
VITE_API_URL_PREFIX = 

# 图片前缀地址
VITE_IMG_URL= https://api.yangruirui.top

# 开启mock
VITE_USE_MOCK = false
