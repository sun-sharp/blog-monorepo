{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationDir": "./types",
    "declarationMap": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "composite": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "/#/*": ["types/*"]
    }
  },
  "include": [
    "types/**/*.ts",
    "types/**/*.d.ts",
    "index.d.ts",
    "src/**/*.ts"
  ],
  "exclude": ["node_modules", "types/src"]
}
