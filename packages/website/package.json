{
  "name": "website",
  "private": true,
  "version": "4.5.4",
  "type": "module",
  "scripts": {
    "dev": "vite --mode dev",
    "dev:prod": "vite --mode prod-local",
    "dev:debug": "vite --mode dev --debug",
    "build": "set NODE_OPTIONS=--no-deprecation && tsc && vite build --mode prod",
    "preview": "vite preview",
    "lint": "eslint src *.ts *.js *.cjs --fix --report-unused-disable-directives --max-warnings 0 && npx tsc --noEmit",
    "lint:stylelint": "stylelint --fix \"**/*.{less,postcss,css,scss}\" --cache --cache-location node_modules/.cache/stylelint/",
    "rm_node_modules": "rimraf yarn.lock && rimraf pnpm-lock.yaml && rimraf package-lock.json && rimraf node_modules"
  },
  "dependencies": {
    "@ant-design/icons": "^6.1.1",
    "@reduxjs/toolkit": "^2.6.1",
    "ahooks": "^3.8.4",
    "antd": "^5.24.8",
    "axios": "^1.9.0",
    "date-fns": "^4.1.0",
    "md-editor-rt": "^5.2.0",
    "react": "^18.3.1",
    "react-activation": "^0.13.4",
    "react-dom": "^18.3.1",
    "react-redux": "^9.2.0",
    "react-router": "^7.5.0",
    "react-router-dom": "^7.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.26.0",
    "@types/node": "^25.6.0",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.6",
    "@vitejs/plugin-react": "^4.5.0",
    "eslint": "^9.26.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.4.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "postcss": "^8.5.10",
    "postcss-html": "^1.8.1",
    "postcss-less": "^6.0.0",
    "postcss-pxtorem": "^6.1.0",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.5.3",
    "react-refresh": "^0.17.0",
    "sass": "^1.88.0",
    "stylelint": "^16.26.1",
    "stylelint-config-rational-order": "^0.1.2",
    "stylelint-config-recommended": "^14.0.1",
    "stylelint-config-recommended-scss": "^14.1.0",
    "stylelint-config-standard": "^37.0.0",
    "stylelint-no-unsupported-browser-features": "^8.1.1",
    "stylelint-order": "^6.0.4",
    "stylelint-scss": "^6.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.32.1",
    "vite": "^6.3.5",
    "vite-plugin-checker": "^0.9.3",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-html": "^3.2.2",
    "vite-plugin-imagemin": "^0.6.1",
    "vite-plugin-pwa": "^0.21.2",
    "vite-plugin-svgr": "^4.3.0",
    "vite-tsconfig-paths": "^5.1.4",
    "workbox-build": "^7.4.1"
  },
  "lint-staged": {
    "*.{vue,ts,js,jsx,tsx,cjs}": [
      "eslint --fix --report-unused-disable-directives --max-warnings 0"
    ]
  }
}
