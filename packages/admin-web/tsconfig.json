{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "skipDefaultLibCheck": true,
    "ignoreDeprecations": "6.0",
    "outDir": "./",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "/#/api/*": [
        "../shared/types/api/*"
      ],
      "/#/models/*": [
        "../shared/types/models/*"
      ],
      "/#/vue/*": [
        "../shared/types/vue/*"
      ],
      "/#/common/*": [
        "../shared/types/common/*"
      ],
      "/#/*": [
        "../shared/types/vue/*"
      ],
      "/#/utils/*": [
        "../shared/src/utils/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.vue",
    "../shared/types/api/**/*.d.ts",
    "../shared/types/models/**/*.d.ts",
    "../shared/types/vue/**/*.d.ts",
    "../shared/types/common/**/*.d.ts",
    "build/**/*.ts",
    "build/**/*.d.ts",
    "mock/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "manage",
    "dist",
    "**/*.js"
  ],
  "references": [
    {
      "path": "./tsconfig.node.json"
    },
    {
      "path": "../shared"
    }
  ]
}
