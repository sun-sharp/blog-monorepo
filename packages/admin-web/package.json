{
  "name": "admin-web",
  "version": "4.5.5",
  "type": "module",
  "scripts": {
    "dev": "vite --mode dev-local",
    "dev:text": "vite --mode dev",
    "dev:debug": "vite --mode dev --debug",
    "dev:prod": "vite --mode prod-local",
    "build": "vue-tsc --noEmit && vite build --mode prod",
    "preview": "vite preview --outDir manage --base /manage/",
    "lint": "eslint \"{src,mock,build,types}/**/*.{vue,ts,tsx}\" --fix && vue-tsc --noEmit",
    "lint:stylelint": "stylelint --fix \"**/*.{vue,less,postcss,css,scss}\" --cache --cache-location node_modules/.cache/stylelint/",
    "rm_node_modules": "rimraf yarn.lock && rimraf pnpm-lock.yaml && rimraf package-lock.json && rimraf node_modules"
  },
  "dependencies": {
    "@antv/g2plot": "^2.4.31",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@eslint/js": "^10.0.1",
    "@vicons/antd": "^0.13.0",
    "@vicons/ionicons5": "^0.13.0",
    "@vueuse/core": "^14.2.1",
    "await-to-js": "^3.0.0",
    "axios": "^1.15.2",
    "date-fns": "^4.1.0",
    "echarts": "^6.0.0",
    "element-resize-detector": "^1.2.4",
    "makeit-captcha": "^2.0.6",
    "md-editor-v3": "^6.4.2",
    "mockjs": "^1.1.0",
    "naive-ui": "^2.44.1",
    "pinia": "^2.3.1",
    "qs": "^6.11.2",
    "turndown": "^7.1.2",
    "vue": "^3.5.33",
    "vue-router": "^4.6.4",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@types/element-resize-detector": "^1.1.3",
    "@types/node": "^25.6.0",
    "@types/qs": "^6.9.7",
    "@types/turndown": "^5.0.4",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitejs/plugin-vue-jsx": "^5.1.5",
    "autoprefixer": "^10.4.14",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-vue": "^10.9.0",
    "postcss": "^8.4.27",
    "postcss-html": "^1.5.0",
    "postcss-scss": "^4.0.6",
    "prettier": "^3.8.3",
    "sass": "^1.64.2",
    "sass-loader": "^13.3.2",
    "stylelint": "^17.9.0",
    "stylelint-config-rational-order": "^0.1.2",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-config-standard-vue": "^1.0.0",
    "stylelint-no-unsupported-browser-features": "^8.1.1",
    "stylelint-order": "^8.1.1",
    "terser": "^5.19.2",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vite-plugin-html": "^3.2.2",
    "vite-plugin-mock": "^3.0.0",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^3.2.7"
  },
  "lint-staged": {
    "*.{vue,js,ts,tsx}": "eslint --fix"
  },
  "license": "MIT",
  "keywords": [
    "vue",
    "naive-ui",
    "admin-web",
    "vue3",
    "ts",
    "tsx",
    "admin",
    "typescript"
  ],
  "engines": {
    "node": "^12 || >=14"
  }
}
