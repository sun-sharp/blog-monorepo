  "scripts": {
    "dev:h5": "uni --mode dev-local",
    "dev:h5:dev": "uni --mode dev",
    "dev:h5:prod": "uni --mode prod",
    "dev:mp-weixin": "uni -p mp-weixin --mode dev-local",
