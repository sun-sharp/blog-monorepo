    "dev:app:prod": "uni -p app --mode prod",
    "build:h5": "uni build --mode prod",
    "build:mp-weixin": "uni build -p mp-weixin --mode prod",
    "build:app": "uni build -p app --mode prod",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint src --ext .vue,.js,.ts,.tsx --fix"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-4060620250520001",
