    "@dcloudio/uni-mp-weixin": "3.0.0-4060620250520001",
    "vue": "^3.4.21",
    "pinia": "^2.3.1",
    "uview-plus": "^3.3.0",
    "date-fns": "^4.1.0",
    "await-to-js": "^3.0.0",
    "lodash-es": "^4.17.21"
