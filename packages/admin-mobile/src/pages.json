        "selectedIconPath": "static/tabbar/setting-active.png",
        "text": "设置"
      }
    ]
  },
  "easycom": {
    "autoscan": true,
    "custom": {
      "^u-(.*)": "uview-plus/components/u-$1/u-$1.vue",
