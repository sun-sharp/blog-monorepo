# 只在开发模式中被载入（HBuilderX 运行时自动加载）

# 是否删除console
VITE_DROP_CONSOLE = false

# token 前加符号
VITE_AUTHORIZATION_HEAD = 'Bearer '

# capital接口地址（H5走代理用 /capital-api，App/小程序用 /capital）
VITE_CAPITAL_API_URL = /capital

# blog接口地址（H5走代理用 /blog-api，App/小程序用 /blog）
VITE_BLOG_API_URL = /blog

# 后端基础地址（App/小程序直接请求，H5走代理不需要）
VITE_BASE_URL = http://127.0.0.1:3000
