{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "skipDefaultLibCheck": true,
    "ignoreDeprecations": "6.0",
    "outDir": "./",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@shared/*": [
        "../shared/src/*"
      ],
      "/#/*": [
        "../shared/types/*"
      ]
    },
    "types": [
      "@dcloudio/types"
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.d.ts",
    "**/*.vue",
    "../shared/types/**/*.d.ts",
    "../shared/src/**/*.ts",
    "../shared/src/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "unpackage",
    "dist",
    "**/*.js"
  ],
  "references": [
    {
      "path": "../shared"
    }
  ]
}
