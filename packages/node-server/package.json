{
  "name": "alone-blog-api",
  "version": "2.6.2",
  "description": "",
  "author": "yrr",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "start:dev": "cross-env RUNNING_ENV=dev nest start",
    "start:dev_watch_debug": "rimraf dist && cross-env RUNNING_ENV=dev nest start --watch --debug",
    "start:prod": "cross-env RUNNING_ENV=prod nest start",
    "start:prod_watch_debug": "rimraf dist && cross-env RUNNING_ENV=prod nest start --watch --debug",
    "rim:dist": "rimraf dist",
    "build": "rimraf dist && nest build",
    "format": "prettier --write \"{src,types}/**/*.ts\"",
    "lint": "eslint \"{src,types}/**/*.ts\" --fix",
    "compodoc": "npx compodoc -p tsconfig.json -r 8000 -s --language=zh-CN --hideGenerator -n \"api接口文档\" --theme postmark",
    "update_dev_pm2": "npm install && pm2 stop dev_nest && pm2 delete dev_nest && npm run build && pm2 list && cross-env RUNNING_ENV=dev pm2 start --name dev_nest dist/main.js",
    "update_prod_pm2": "npm install && pm2 stop nest && pm2 delete nest && npm run build && pm2 list && cross-env RUNNING_ENV=prod pm2 start --name nest dist/main.js"
  },
  "dependencies": {
    "@nestjs/common": "^10.2.7",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.2.7",
    "@nestjs/jwt": "^10.1.1",
    "@nestjs/mapped-types": "^2.0.2",
    "@nestjs/mongoose": "^10.0.1",
    "@nestjs/passport": "^10.0.2",
    "@nestjs/platform-express": "^10.2.7",
    "@nestjs/schedule": "^4.0.0",
    "@nestjs/swagger": "^7.1.14",
    "bcrypt": "^5.1.1",
    "body-parser": "^1.20.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "date-fns": "^2.30.0",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "mongoose": "^7.6.4",
    "passport": "^0.6.0",
    "passport-jwt": "^4.0.1",
    "puppeteer": "^22.3.0",
    "reflect-metadata": "^0.1.13",
    "rimraf": "^5.0.5",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.0"
  },
  "devDependencies": {
    "@compodoc/compodoc": "^1.1.22",
    "@nestjs/cli": "^10.2.1",
    "@nestjs/schematics": "^10.0.3",
    "@nestjs/testing": "^10.2.7",
    "@types/bcrypt": "^5.0.1",
    "@types/cron": "^2.0.1",
    "@types/dotenv": "^8.2.0",
    "@types/express": "^4.17.20",
    "@types/jest": "^29.5.7",
    "@types/multer": "^1.4.9",
    "@types/node": "^20.8.10",
    "@types/passport-jwt": "^3.0.12",
    "@types/supertest": "^2.0.15",
    "@typescript-eslint/eslint-plugin": "^6.9.1",
    "@typescript-eslint/parser": "^6.9.1",
    "cross-env": "^7.0.3",
    "eslint": "^8.52.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.1",
    "jest": "^29.7.0",
    "prettier": "^3.0.3",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-loader": "^9.5.0",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.2.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
