# 运行环境 (dev | prod)
RUNNING_ENV=dev

# 端口
PORT=3002

# JWT 密钥（至少 16 个字符，请使用随机字符串）
JWT_SECRET=local-prod-secret-key-2024

# JWT 过期时间（如 1d, 7d, 12h）
JWT_EXPIRES_IN=7d

# blog 类型数据库名称
BLOG_DATABASE_NAME=xxx

# capital 类型数据库名称
CAPITAL_DATABASE_NAME=xxx

# 图片前缀名称
IMAGE_REFIX_NAME=xxx

# 静态文件目录名称
STATIC_DIR_NAME=xxx

# 静态文件目录位置（相对于项目根目录）
STATIC_DIR_POSITION=../

# 文件访问路径
FILE_ACCESS_PATH=xxx

# 服务器 IP
SERVER_IP=0.0.0.0

# MongoDB 数据库端口
DATABASE_PORT=1111

# MongoDB 账号
MONGODB_ACCOUNT=xxx

# MongoDB 密码
MONGODB_PASSWORD=xxx

# MongoDB 查询参数（用于身份验证）
MONGODB_QUERY=xxx

