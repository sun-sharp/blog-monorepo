# 网站根目录
VITE_PUBLIC_PATH = /


# 跨域代理，可以配置多个，请注意不要换行
VITE_PROXY=[["/blog-api","https://yangruirui.top/blog"]]

# blog接口地址
VITE_GLOB_BLOG_API_URL= /blog-api

# mock接口地址
VITE_GLOB_MOCK_API_URL= /mock-api

# 接口前缀
VITE_GLOB_API_URL_PREFIX = 

# 是否启用gzip压缩或brotli压缩
# 可选: gzip | brotli | none
# 如果你需要多种形式，你可以用','来分隔
VITE_BUILD_COMPRESS = 'none'

# 使用压缩时是否删除原始文件，默认为false
VITE_BUILD_COMPRESS_DELETE_ORIGIN_FILE = false
