# 只在开发模式中被载入
VITE_PORT = 8333

# 网站根目录
VITE_PUBLIC_PATH = /manage/

# 是否删除console
VITE_DROP_CONSOLE = true

# token 前加符号
VITE_AUTHORIZATION_HEAD = 'Bearer '

# 跨域代理，可以配置多个，请注意不要换行
VITE_PROXY = `[
    ["/capital-api", "https://www.yangruirui.top/capital-api"], 
    ["/blog-api", "https://www.yangruirui.top/blog-api"], 
    ["/api_file", "https://www.yangruirui.top/api_file"]
  ]`

# capital接口地址
VITE_CAPITAL_API_URL = /capital-api

# blog接口地址
VITE_BLOG_API_URL = /blog-api

# 开启mock
VITE_USE_MOCK = false
